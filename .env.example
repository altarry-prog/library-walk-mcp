# NON-SECRET Docker configuration only. Do not put credentials in this file.
# Set MCP_ACCESS_TOKEN and optional NARU_KEY using host environment / a secret manager.
# Never paste credentials into chat, an Agent prompt, a file or a source repository.
# Public domain needed only for the HTTPS compose deployment. Do not include https:// here.
PUBLIC_HOST=
MCP_TRANSPORT=streamable-http
HOST=127.0.0.1
PORT=8000
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*
MCP_ALLOWED_ORIGINS=
CATALOG_PATH=data/demo_catalog.json
REQUESTS_PER_MINUTE=60
# BOTH gates remain false until explicit contest/organization approval and quota review.
EXTERNAL_LINK_APPROVED=false
ALLOW_LIVE_CALLS=false
MAX_NARU_CALLS_PER_PROCESS=5
