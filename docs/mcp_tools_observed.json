  {
    "name": "make_visit_plan",
    "description": "구조화한 조건으로 같은 시설의 책·프로그램·공간 후보를 대조. 신청·예약하지 않음.\ndate=YYYY-MM-DD, start_time/end_time=HH:MM. 모의지역 DEMO, 주제 우주, 대상 가족.\n모르는 이용자 조건을 채우지 말고 먼저 물으세요. allow_unknown=true인 결과의 미확인 사항을 유지하세요.\n",
    "inputSchema": {
      "$defs": {
        "PlanRequest": {
          "additionalProperties": false,
          "properties": {
            "region": {
              "maxLength": 80,
              "minLength": 1,
              "title": "Region",
              "type": "string"
            },
            "date": {
              "format": "date",
              "title": "Date",
              "type": "string"
            },
            "start_time": {
              "title": "Start Time",
              "type": "string"
            },
            "end_time": {
              "title": "End Time",
              "type": "string"
            },
            "topic": {
              "maxLength": 40,
              "minLength": 1,
              "title": "Topic",
              "type": "string"
            },
            "audience": {
              "maxLength": 20,
              "minLength": 1,
              "title": "Audience",
              "type": "string"
            },
            "group_size": {
              "maximum": 100,
              "minimum": 1,
              "title": "Group Size",
              "type": "integer"
            },
            "space_minutes": {
              "maximum": 240,
              "minimum": 15,
              "title": "Space Minutes",
              "type": "integer"
            },
            "budget_krw": {
              "maximum": 10000000,
              "minimum": 0,
              "title": "Budget Krw",
              "type": "integer"
            },
            "needs": {
              "items": {
                "type": "string"
              },
              "maxItems": 8,
              "title": "Needs",
              "type": "array"
            },
            "allow_unknown": {
              "default": false,
              "title": "Allow Unknown",
              "type": "boolean"
            },
            "limit": {
              "default": 3,
              "maximum": 5,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          "required": [
            "region",
            "date",
            "start_time",
            "end_time",
            "topic",
            "audience",
            "group_size",
            "space_minutes",
            "budget_krw"
          ],
          "title": "PlanRequest",
          "type": "object"
        }
      },
      "properties": {
        "request": {
          "$ref": "#/$defs/PlanRequest"
        }
      },
      "required": [
        "request"
      ],
      "title": "make_visit_planArguments",
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    }
  },
